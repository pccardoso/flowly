PORT=3000
APP_HOST_PORT=3001

JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

POSTGRES_USER=flowly
POSTGRES_PASSWORD=flowly
POSTGRES_DB=flowly
POSTGRES_PORT=5432

MINIO_ROOT_USER=flowly
MINIO_ROOT_PASSWORD=flowly123
MINIO_BUCKET=flowly-anexos
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

REDIS_HOST_PORT=6379

# Chave AES-256 (32 bytes em hex, ex.: `openssl rand -hex 32`) usada pra
# cifrar a senha/app-password dos provedores de email antes de gravar no
# banco. Se não definida, uma chave é derivada de JWT_SECRET (funciona, mas
# defina esta em produção — trocar JWT_SECRET sem trocar isto invalidaria as
# senhas já cifradas).
EMAIL_CREDENTIALS_KEY=

# Caminho do binário do Chromium usado pelo PdfRendererService (exportação de
# PDF de card). Necessário fora do Docker (o docker-compose.yml já define o
# caminho do Chromium instalado via apk na imagem). Localmente, aponte pro
# Chrome/Chromium instalado na sua máquina, ex. no Windows:
# "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
PUPPETEER_EXECUTABLE_PATH=
